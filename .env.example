# =============================================================================
# MemOS Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to .env and fill in REAL values.
#   cp .env.example .env
# Then generate a real secret key:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Application
PROJECT_NAME="MemOS"
API_V1_STR="/api/v1"
# REQUIRED: Generate a strong random secret key, e.g. with the command above.
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL)
# Required: set a strong POSTGRES_PASSWORD and update DATABASE_URL accordingly.
POSTGRES_USER="memos_user"
POSTGRES_PASSWORD=""
POSTGRES_DB="memos_db"
DATABASE_URL="postgresql://memos_user:<YOUR_POSTGRES_PASSWORD>@localhost:5432/memos_db"

# Redis Embedding Cache (24h TTL; gracefully skipped if Redis is not running)
REDIS_URL="redis://localhost:6379/0"

# Qdrant Vector Database
QDRANT_HOST="localhost"
QDRANT_PORT=6333

# Neo4j Knowledge Graph
# Required: set a strong NEO4J_PASSWORD to match your Neo4j setup.
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD=""
# Docker Compose authentication value; keep the password identical to NEO4J_PASSWORD.
NEO4J_AUTH="neo4j/<YOUR_NEO4J_PASSWORD>"

# Local Ollama & Proxy Integration
OLLAMA_BASE_URL="http://127.0.0.1:11434"
PROXY_HOST="127.0.0.1"
PROXY_PORT=11435
# Optional: defaults to the first model found installed on your Ollama instance.
DEFAULT_LLM_MODEL=""
DEFAULT_EMBEDDING_MODEL="nomic-embed-text"

# Lifecycle scheduler interval in hours (default: 24). Set to 1 for testing.
LIFECYCLE_INTERVAL_HOURS=24
