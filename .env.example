# =============================================================================
# MemOS Environment Configuration Template (.env.example)
# =============================================================================

# Application
PROJECT_NAME="MemOS"
API_V1_STR="/api/v1"
SECRET_KEY="generate_a_secure_random_32_character_key_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://memos_user:memos_password@localhost:5432/memos_db"
POSTGRES_USER="memos_user"
POSTGRES_PASSWORD="memos_password"
POSTGRES_DB="memos_db"

# Redis Cache
REDIS_URL="redis://localhost:6379/0"

# Qdrant Vector Database
QDRANT_HOST="localhost"
QDRANT_PORT=6333

# Neo4j Knowledge Graph
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="memos_password"

# Local Ollama & Proxy Integration
OLLAMA_BASE_URL="http://127.0.0.1:11434"
PROXY_HOST="127.0.0.1"
PROXY_PORT=11435
DEFAULT_LLM_MODEL="qwen3.5:9b"
DEFAULT_EMBEDDING_MODEL="nomic-embed-text"

# Frontend API Target
NEXT_PUBLIC_API_URL="http://localhost:8000"
