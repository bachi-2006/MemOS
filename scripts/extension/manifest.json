{
  "manifest_version": 3,
  "name": "MemOS - Memory Sync Extension",
  "version": "1.0.0",
  "description": "One-click memory sharing plugin for local Web UIs, Ollama, and ChatGPT.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "MemOS Memory Sync"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.mistral.ai/*",
        "https://perplexity.ai/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["content.js"]
    }
  ]
}
